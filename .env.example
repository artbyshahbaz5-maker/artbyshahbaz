NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated list of emails allowed into the admin panel (/admin + /api/admin).
# Leave blank to allow ANY authenticated Supabase user (not recommended in prod).
ADMIN_EMAILS=admin@artbyshahbaz.com

# Only needed for scripts/ utilities
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password
